{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5433;Database=hitek_ai_iot;Username=hitek_app;Password=hitek_app_password"
  },
  "Jwt": {
    "Issuer": "hitek-backend-api",
    "Audience": "hitek-ai-iot",
    "SigningKey": ""
  },
  "Auth": {
    "UserTokenMinutes": 60,
    "ServiceTokenMinutes": 720,
    "Clients": []
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "AiService": {
    "PublicBaseUrl": "http://localhost:8010"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "RiskEngine": {
    "DebounceCount": 3,
    "AiActiveWindowSeconds": 3,
    "MinConfidence": 0.6,
    "CooldownSeconds": 60,
    "AllowedStartUtcHour": 1,
    "AllowedEndUtcHour": 11
  },
  "SensorMonitor": {
    "OfflineAfterSeconds": 30,
    "ScanIntervalSeconds": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
