{
  "Mqtt": {
    "Enabled": true,
    "Host": "localhost",
    "Port": 1883,
    "ClientId": "hitek-iot-service",
    "ReadingTopicFilter": "hitek/+/reading"
  },
  "BackendApi": {
    "BaseUrl": "http://localhost:5250",
    "ClientId": "iot-service",
    "ClientSecret": "",
    "TimeoutSeconds": 10
  },
  "Ingest": {
    "QueueCapacity": 1000,
    "DeviceTimeZone": "UTC",
    "MaxFutureSkewSeconds": 300,
    "RetryInitialDelayMilliseconds": 1000,
    "RetryMaxDelaySeconds": 30
  },
  "Jwt": {
    "Issuer": "hitek-backend-api",
    "Audience": "hitek-ai-iot",
    "SigningKey": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}
